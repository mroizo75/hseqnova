# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — URL + anon (browser/RLS) + service role (server). Never a Postgres DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth (kept until login is fully on Supabase Auth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe (VAT invoices, Billing, Bacs Direct Debit, cards)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_CORE_YEARLY=
STRIPE_PRICE_RAMS_MONTHLY=
STRIPE_PRICE_COSHH_MONTHLY=
STRIPE_PRICE_CDM_MONTHLY=
STRIPE_PRICE_TAVLE_MONTHLY=
STRIPE_PRICE_AUDITS_MONTHLY=
STRIPE_PRICE_ENVIRONMENT_MONTHLY=

# Cloudflare R2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hseqnova

# Resend
RESEND_API_KEY=
RESEND_FROM=HSEQ Nova <hello@hseqnova.co.uk>

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Companies House
COMPANIES_HOUSE_API_KEY=

# Optional
UPLOADTHING_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
